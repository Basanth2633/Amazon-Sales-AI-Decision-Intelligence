    @task
    def check_source_file() -> dict:
        """
        Confirm that the source CSV exists and is not empty.
        """

        if not CSV_PATH.exists():
            raise FileNotFoundError(
                f"Source file was not found: {CSV_PATH}"
            )

        file_size = CSV_PATH.stat().st_size

        if file_size == 0:
            raise ValueError(
                f"Source file exists but is empty: {CSV_PATH}"
            )

        result = {
            "file_path": str(CSV_PATH),
            "file_name": CSV_PATH.name,
            "file_size_bytes": file_size,
            "status": "Source file validation successful",
        }

        print(result)
        return result

    @task
    def extract_and_validate_csv(file_info: dict) -> dict:
        import pandas as pd

        file_path = file_info["file_path"]

        df = pd.read_csv(file_path)

        required_columns = {
            "order_id",
            "order_date",
            "product_id",
            "product_category",
            "price",
            "discount_percent",
            "quantity_sold",
            "customer_region",
            "payment_method",
            "rating",
            "review_count",
            "discounted_price",
            "total_revenue",
            "profit",
        }

        missing_columns = required_columns - set(df.columns)

        if missing_columns:
            raise ValueError(
                f"Missing required columns: {sorted(missing_columns)}"
            )

        if df.empty:
            raise ValueError("The CSV contains no data rows.")

        result = {
            "file_path": file_path,
            "row_count": len(df),
            "column_count": len(df.columns),
            "columns": df.columns.tolist(),
            "status": "CSV extraction and schema validation successful",
        }

        print(result)
        return result


    @task
    def clean_and_transform_data(csv_info: dict) -> dict:
        from pathlib import Path

        import pandas as pd

        file_path = csv_info["file_path"]

        processed_path = Path(
            "/opt/airflow/data/processed/amazon_sales_cleaned.csv"
        )
        rejected_path = Path(
            "/opt/airflow/data/rejected/amazon_sales_rejected.csv"
        )

        df = pd.read_csv(file_path)

        original_row_count = len(df)

        # Convert date column
        df["order_date"] = pd.to_datetime(
            df["order_date"],
            errors="coerce"
        )

        # Convert numeric columns
        numeric_columns = [
            "order_id",
            "product_id",
            "price",
            "discount_percent",
            "quantity_sold",
            "rating",
            "review_count",
            "discounted_price",
            "total_revenue",
            "profit",
        ]

        for column in numeric_columns:
            df[column] = pd.to_numeric(
                df[column],
                errors="coerce"
            )

        # Standardize text columns
        text_columns = [
            "product_category",
            "customer_region",
            "payment_method",
        ]

        for column in text_columns:
            df[column] = (
                df[column]
                .astype("string")
                .str.strip()
                .str.title()
            )

        # Mark invalid records
        invalid_mask = (
            df["order_id"].isna()
            | df["order_date"].isna()
            | df["product_id"].isna()
            | df["price"].lt(0)
            | ~df["discount_percent"].between(0, 100)
            | df["quantity_sold"].le(0)
            | ~df["rating"].between(0, 5)
            | df["review_count"].lt(0)
            | df["discounted_price"].lt(0)
            | df["total_revenue"].lt(0)
        )

        rejected_df = df[invalid_mask].copy()
        valid_df = df[~invalid_mask].copy()

        # Remove duplicate order IDs from valid records
        duplicate_mask = valid_df.duplicated(
            subset=["order_id"],
            keep="first"
        )

        duplicate_df = valid_df[duplicate_mask].copy()
        valid_df = valid_df[~duplicate_mask].copy()

        rejected_df = pd.concat(
            [rejected_df, duplicate_df],
            ignore_index=True
        )

        # Create additional analytics columns
        valid_df["order_year"] = valid_df["order_date"].dt.year
        valid_df["order_month"] = valid_df["order_date"].dt.month
        valid_df["month_name"] = valid_df["order_date"].dt.month_name()
        valid_df["order_quarter"] = valid_df["order_date"].dt.quarter
        valid_df["weekday_name"] = valid_df["order_date"].dt.day_name()

        valid_df["discount_group"] = pd.cut(
            valid_df["discount_percent"],
            bins=[-0.01, 0, 10, 20, 100],
            labels=[
                "No Discount",
                "Low Discount",
                "Medium Discount",
                "High Discount",
            ],
            include_lowest=True,
        )

        valid_df["profit_margin_percent"] = (
            valid_df["profit"]
            / valid_df["total_revenue"].replace(0, pd.NA)
            * 100
        ).round(2)

        processed_path.parent.mkdir(
            parents=True,
            exist_ok=True
        )
        rejected_path.parent.mkdir(
            parents=True,
            exist_ok=True
        )

        valid_df.to_csv(processed_path, index=False)
        rejected_df.to_csv(rejected_path, index=False)

        result = {
            "clean_file_path": str(processed_path),
            "rejected_file_path": str(rejected_path),
            "original_row_count": original_row_count,
            "valid_row_count": len(valid_df),
            "rejected_row_count": len(rejected_df),
            "status": "Data cleaning and transformation successful",
        }

        print(result)
        return result

    @task
    def load_staging_table(cleaning_info: dict) -> dict:
        import pandas as pd
        from airflow.providers.mysql.hooks.mysql import MySqlHook

        clean_file_path = cleaning_info["clean_file_path"]

        # Read the cleaned CSV created by the previous task
        df = pd.read_csv(clean_file_path)

        if df.empty:
            raise ValueError("The cleaned CSV is empty. Nothing can be loaded.")

        # Convert the date column again because CSV files do not preserve DATE types
        df["order_date"] = pd.to_datetime(
            df["order_date"],
            errors="coerce"
        ).dt.date

        # Convert Pandas missing values into Python None for MySQL NULL
        df = df.astype(object).where(pd.notna(df), None)

        columns_to_load = [
            "order_id",
            "order_date",
            "product_id",
            "product_category",
            "price",
            "discount_percent",
            "quantity_sold",
            "customer_region",
            "payment_method",
            "rating",
            "review_count",
            "discounted_price",
            "total_revenue",
            "profit",
            "order_year",
            "order_month",
            "month_name",
            "order_quarter",
            "weekday_name",
            "discount_group",
            "profit_margin_percent",
        ]

        # Confirm that the cleaned file contains every required column
        missing_columns = set(columns_to_load) - set(df.columns)

        if missing_columns:
            raise ValueError(
                f"Cleaned CSV is missing columns: {sorted(missing_columns)}"
            )

        df = df[columns_to_load]

        insert_sql = """
            INSERT INTO stg_amazon_sales (
                order_id,
                order_date,
                product_id,
                product_category,
                price,
                discount_percent,
                quantity_sold,
                customer_region,
                payment_method,
                rating,
                review_count,
                discounted_price,
                total_revenue,
                profit,
                order_year,
                order_month,
                month_name,
                order_quarter,
                weekday_name,
                discount_group,
                profit_margin_percent
            )
            VALUES (
                %s, %s, %s, %s, %s, %s, %s,
                %s, %s, %s, %s, %s, %s, %s,
                %s, %s, %s, %s, %s, %s, %s
            )
        """

        mysql_hook = MySqlHook(
            mysql_conn_id="mysql_amazon_sales"
        )

        connection = mysql_hook.get_conn()
        cursor = connection.cursor()

        try:
            # Full refresh: remove data from the previous pipeline run
            cursor.execute("TRUNCATE TABLE stg_amazon_sales")

            batch_size = 1000
            total_loaded = 0

            for start_index in range(0, len(df), batch_size):
                batch_df = df.iloc[
                    start_index:start_index + batch_size
                ]

                records = list(
                    batch_df.itertuples(index=False, name=None)
                )

                cursor.executemany(insert_sql, records)
                total_loaded += len(records)

            connection.commit()

            # Verify how many rows now exist in the staging table
            cursor.execute(
                "SELECT COUNT(*) FROM stg_amazon_sales"
            )
            staging_row_count = cursor.fetchone()[0]

            if staging_row_count != len(df):
                raise ValueError(
                    "Staging-table row count does not match the cleaned file. "
                    f"Expected {len(df)}, found {staging_row_count}."
                )

            result = {
                "source_clean_rows": len(df),
                "rows_loaded": total_loaded,
                "staging_row_count": staging_row_count,
                "table_name": "stg_amazon_sales",
                "status": "Staging-table load successful",
            }

            print(result)
            return result

        except Exception:
            connection.rollback()
            raise

        finally:
            cursor.close()
            connection.close()
    @task
    def validate_staging_data(staging_info: dict) -> dict:
        from airflow.providers.mysql.hooks.mysql import MySqlHook

        mysql_hook = MySqlHook(
            mysql_conn_id="mysql_amazon_sales"
        )

        expected_rows = staging_info["staging_row_count"]

        validation_sql = """
            SELECT
                COUNT(*) AS total_rows,

                SUM(
                    CASE
                        WHEN order_id IS NULL THEN 1
                        ELSE 0
                    END
                ) AS missing_order_ids,

                COUNT(*) - COUNT(DISTINCT order_id)
                    AS duplicate_order_ids,

                SUM(
                    CASE
                        WHEN order_date IS NULL THEN 1
                        ELSE 0
                    END
                ) AS missing_order_dates,

                SUM(
                    CASE
                        WHEN product_id IS NULL THEN 1
                        ELSE 0
                    END
                ) AS missing_product_ids,

                SUM(
                    CASE
                        WHEN discount_percent < 0
                        OR discount_percent > 100
                        THEN 1
                        ELSE 0
                    END
                ) AS invalid_discounts,

                SUM(
                    CASE
                        WHEN rating < 0
                        OR rating > 5
                        THEN 1
                        ELSE 0
                    END
                ) AS invalid_ratings,

                SUM(
                    CASE
                        WHEN price < 0
                        OR discounted_price < 0
                        OR total_revenue < 0
                        THEN 1
                        ELSE 0
                    END
                ) AS invalid_financial_values,

                SUM(
                    CASE
                        WHEN quantity_sold <= 0
                        THEN 1
                        ELSE 0
                    END
                ) AS invalid_quantities

            FROM stg_amazon_sales
        """

        result = mysql_hook.get_first(validation_sql)

        (
            total_rows,
            missing_order_ids,
            duplicate_order_ids,
            missing_order_dates,
            missing_product_ids,
            invalid_discounts,
            invalid_ratings,
            invalid_financial_values,
            invalid_quantities,
        ) = result

        failures = []

        if total_rows == 0:
            failures.append("The staging table is empty.")

        if total_rows != expected_rows:
            failures.append(
                f"Expected {expected_rows} rows, but found {total_rows}."
            )

        if missing_order_ids > 0:
            failures.append(
                f"{missing_order_ids} rows have missing order IDs."
            )

        if duplicate_order_ids > 0:
            failures.append(
                f"{duplicate_order_ids} duplicate order IDs were found."
            )

        if missing_order_dates > 0:
            failures.append(
                f"{missing_order_dates} rows have missing order dates."
            )

        if missing_product_ids > 0:
            failures.append(
                f"{missing_product_ids} rows have missing product IDs."
            )

        if invalid_discounts > 0:
            failures.append(
                f"{invalid_discounts} invalid discount values were found."
            )

        if invalid_ratings > 0:
            failures.append(
                f"{invalid_ratings} invalid rating values were found."
            )

        if invalid_financial_values > 0:
            failures.append(
                f"{invalid_financial_values} invalid financial values "
                "were found."
            )

        if invalid_quantities > 0:
            failures.append(
                f"{invalid_quantities} invalid quantity values were found."
            )

        if failures:
            raise ValueError(
                "Staging data validation failed: "
                + " ".join(failures)
            )

        validation_result = {
            "table_name": "stg_amazon_sales",
            "total_rows": total_rows,
            "missing_order_ids": missing_order_ids,
            "duplicate_order_ids": duplicate_order_ids,
            "missing_order_dates": missing_order_dates,
            "missing_product_ids": missing_product_ids,
            "invalid_discounts": invalid_discounts,
            "invalid_ratings": invalid_ratings,
            "invalid_financial_values": invalid_financial_values,
            "invalid_quantities": invalid_quantities,
            "status": "Staging data-quality validation passed",
        }

        print(validation_result)
        return validation_result
