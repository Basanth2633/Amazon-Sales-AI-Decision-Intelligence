    @task
    def create_analytics_views(fact_info: dict) -> dict:
        from airflow.providers.mysql.hooks.mysql import MySqlHook

        mysql_hook = MySqlHook(
            mysql_conn_id="mysql_amazon_sales"
        )

        expected_rows = fact_info["loaded_rows"]

        if expected_rows <= 0:
            raise ValueError(
                "The fact table contains no data. "
                "Analytics views cannot be created."
            )

        view_queries = {
            "vw_monthly_performance": """
                CREATE OR REPLACE VIEW vw_monthly_performance AS
                SELECT
                    YEAR(order_date) AS sales_year,
                    MONTH(order_date) AS sales_month_number,
                    DATE_FORMAT(order_date, '%Y-%m') AS sales_month,
                    MONTHNAME(order_date) AS month_name,
                    COUNT(DISTINCT order_id) AS total_orders,
                    SUM(quantity_sold) AS total_units_sold,
                    ROUND(SUM(total_revenue), 2) AS total_revenue,
                    ROUND(SUM(profit), 2) AS total_profit,
                    ROUND(
                        SUM(total_revenue)
                        / NULLIF(COUNT(DISTINCT order_id), 0),
                        2
                    ) AS average_order_value,
                    ROUND(
                        SUM(profit)
                        / NULLIF(SUM(total_revenue), 0) * 100,
                        2
                    ) AS profit_margin_percent
                FROM fact_amazon_sales
                GROUP BY
                    YEAR(order_date),
                    MONTH(order_date),
                    DATE_FORMAT(order_date, '%Y-%m'),
                    MONTHNAME(order_date)
            """,

            "vw_category_performance": """
                CREATE OR REPLACE VIEW vw_category_performance AS
                SELECT
                    product_category,
                    COUNT(DISTINCT order_id) AS total_orders,
                    COUNT(DISTINCT product_id) AS distinct_products,
                    SUM(quantity_sold) AS total_units_sold,
                    ROUND(SUM(total_revenue), 2) AS total_revenue,
                    ROUND(SUM(profit), 2) AS total_profit,
                    ROUND(AVG(rating), 2) AS average_rating,
                    SUM(review_count) AS total_reviews,
                    ROUND(
                        SUM(profit)
                        / NULLIF(SUM(total_revenue), 0) * 100,
                        2
                    ) AS profit_margin_percent
                FROM fact_amazon_sales
                GROUP BY product_category
            """,

            "vw_region_performance": """
                CREATE OR REPLACE VIEW vw_region_performance AS
                SELECT
                    customer_region,
                    COUNT(DISTINCT order_id) AS total_orders,
                    SUM(quantity_sold) AS total_units_sold,
                    ROUND(SUM(total_revenue), 2) AS total_revenue,
                    ROUND(SUM(profit), 2) AS total_profit,
                    ROUND(AVG(rating), 2) AS average_rating,
                    ROUND(
                        SUM(total_revenue)
                        / NULLIF(COUNT(DISTINCT order_id), 0),
                        2
                    ) AS average_order_value,
                    ROUND(
                        SUM(profit)
                        / NULLIF(SUM(total_revenue), 0) * 100,
                        2
                    ) AS profit_margin_percent
                FROM fact_amazon_sales
                GROUP BY customer_region
            """,

            

            "vw_discount_impact": """
                CREATE OR REPLACE VIEW vw_discount_impact AS
                SELECT
                    discount_group,
                    COUNT(DISTINCT order_id) AS total_orders,
                    SUM(quantity_sold) AS total_units_sold,
                    ROUND(AVG(discount_percent), 2)
                        AS average_discount_percent,
                    ROUND(SUM(total_revenue), 2) AS total_revenue,
                    ROUND(SUM(profit), 2) AS total_profit,
                    ROUND(
                        SUM(total_revenue)
                        / NULLIF(COUNT(DISTINCT order_id), 0),
                        2
                    ) AS average_revenue_per_order,
                    ROUND(
                        SUM(profit)
                        / NULLIF(COUNT(DISTINCT order_id), 0),
                        2
                    ) AS average_profit_per_order,   
                    ROUND(
                        SUM(profit)
                        / NULLIF(SUM(total_revenue), 0) * 100,
                        2
                    ) AS profit_margin_percent
                FROM fact_amazon_sales
                GROUP BY discount_group
            """,
        }

        created_views = []

        for view_name, query in view_queries.items():
            mysql_hook.run(
                sql=query,
                autocommit=True
            )

            created_views.append(view_name)
            print(f"Created or updated view: {view_name}")

        result = {
            "fact_table_rows": expected_rows,
            "views_created": created_views,
            "view_count": len(created_views),
            "status": "Analytics views created successfully",
        }

        print(result)
        return result
    
    @task
    def calculate_insight_metrics(views_info: dict):

        mysql_hook = MySqlHook(
            mysql_conn_id="mysql_amazon_sales"
        )

        overall_sql = """
            SELECT
                COUNT(DISTINCT order_id) AS total_orders,
                ROUND(SUM(total_revenue), 2) AS total_revenue,
                ROUND(SUM(profit), 2) AS total_profit,
                SUM(quantity_sold) AS total_units_sold,
                ROUND(AVG(rating), 2) AS average_rating,
                MIN(order_date) AS analysis_start_date,
                MAX(order_date) AS analysis_end_date
            FROM fact_amazon_sales;
        """
        overall_result = mysql_hook.get_first(overall_sql)
        

        overall_metrics = {
            "total_orders": int(overall_result[0]),
            "total_revenue": float(overall_result[1]),
            "total_profit": float(overall_result[2]),
            "total_units_sold": int(overall_result[3]),
            "average_rating": float(overall_result[4]),
            "analysis_start_date": str(overall_result[5]),
            "analysis_end_date": str(overall_result[6])

        
        }
        
        
        category_sql = """
            SELECT
                product_category,
                ROUND(SUM(total_revenue), 2) AS revenue,
                ROUND(SUM(profit), 2) AS profit,
                SUM(quantity_sold) AS units_sold,
                ROUND(AVG(rating), 2) AS average_rating,
                SUM(review_count) AS total_reviews
            FROM fact_amazon_sales
            GROUP BY product_category
            ORDER BY revenue DESC;
        """
        category_rows = mysql_hook.get_records(category_sql)

        category_metrics = []

        for row in category_rows:
            category_metrics.append({
                "category": row[0],
                "revenue": float(row[1]),
                "profit": float(row[2]),
                "units_sold": int(row[3]),
                "average_rating": float(row[4]),
                "total_reviews": int(row[5])
            })
       
        region_sql = """
                SELECT
                    customer_region,
                    ROUND(SUM(total_revenue), 2) AS revenue,
                    ROUND(SUM(profit), 2) AS profit,
                    COUNT(DISTINCT order_id) AS orders,
                    SUM(quantity_sold) AS units_sold,
                    ROUND(AVG(rating), 2) AS average_rating
                FROM fact_amazon_sales
                GROUP BY customer_region
                ORDER BY revenue DESC;
            """

        region_rows = mysql_hook.get_records(region_sql)

        region_metrics = []

        for row in region_rows:
            region_metrics.append({
                "region": row[0],
                "revenue": float(row[1]),
                "profit": float(row[2]),
                "orders": int(row[3]),
                "units_sold": int(row[4]),
                "average_rating": float(row[5])
            })

        monthly_sql = """
                SELECT
                    YEAR(order_date) AS year,
                    MONTH(order_date) AS month,
                    ROUND(SUM(total_revenue), 2) AS revenue,
                    ROUND(SUM(profit), 2) AS profit,
                    COUNT(DISTINCT order_id) AS orders,
                    SUM(quantity_sold) AS units_sold
                FROM fact_amazon_sales
                GROUP BY
                    YEAR(order_date),
                    MONTH(order_date)
                ORDER BY
                    YEAR(order_date),
                    MONTH(order_date);
            """
        monthly_rows = mysql_hook.get_records(monthly_sql)

        monthly_metrics = []

        for row in monthly_rows:
            monthly_metrics.append({
                "year": int(row[0]),
                "month": int(row[1]),
                "revenue": float(row[2]),
                "profit": float(row[3]),
                "orders": int(row[4]),
                "units_sold": int(row[5])
            })

        discount_sql = """
            
                SELECT
                    discount_group,
                    ROUND(SUM(total_revenue), 2) AS revenue,
                    SUM(quantity_sold) AS units_sold,
                    COUNT(DISTINCT order_id) AS orders,
                    ROUND(AVG(rating), 2) AS average_rating

                FROM (
                    SELECT
                        order_id,
                        total_revenue,
                        quantity_sold,
                        rating,

                        CASE
                            WHEN discount_percent = 0 THEN 'No Discount'
                            WHEN discount_percent <= 10 THEN '1-10%'
                            WHEN discount_percent <= 20 THEN '11-20%'
                            WHEN discount_percent <= 30 THEN '21-30%'
                            ELSE '31%+'
                        END AS discount_group

                    FROM fact_amazon_sales
                ) AS discount_data

                GROUP BY discount_group
                ORDER BY revenue DESC;
            """

        discount_rows = mysql_hook.get_records(discount_sql)

        discount_metrics = []

        for row in discount_rows:
            discount_metrics.append({
                "discount_group": row[0],
                "revenue": float(row[1]),
                "units_sold": int(row[2]),
                "orders": int(row[3]),
                "average_rating": float(row[4])
                })
    
        metrics = {
                    "overall": overall_metrics,
                    "categories": category_metrics,
                    "regions": region_metrics,
                    "monthly_performance": monthly_metrics,
                    "discount_performance": discount_metrics
                }        
        

        return metrics

    @task
    def detect_business_patterns(metrics: dict):

        categories = metrics["categories"]
        regions = metrics["regions"]
        monthly = metrics["monthly_performance"]
        discounts = metrics["discount_performance"]

    
        # 1. CATEGORY PATTERNS
        top_category = max(
            categories,
            key=lambda x: x["revenue"]
        )

        lowest_category = min(
            categories,
            key=lambda x: x["revenue"]
        )

        highest_rated_category = max(
            categories,
            key=lambda x: x["average_rating"]
        )

        lowest_rated_category = min(
            categories,
            key=lambda x: x["average_rating"]
        )

    
        # 2. REGION PATTERNS
        top_region = max(
            regions,
            key=lambda x: x["revenue"]
        )

        lowest_region = min(
            regions,
            key=lambda x: x["revenue"]
        )

        highest_rated_region = max(
            regions,
            key=lambda x: x["average_rating"]
        )

        lowest_rated_region = min(
            regions,
            key=lambda x: x["average_rating"]
        )

    
        # 3. MONTHLY PATTERNS
        best_month = max(
            monthly,
            key=lambda x: x["revenue"]
        )

        worst_month = min(
            monthly,
            key=lambda x: x["revenue"]
        )

        monthly_growth = []

        for i in range(1, len(monthly)):

            previous_month = monthly[i - 1]
            current_month = monthly[i]

            previous_revenue = previous_month["revenue"]
            current_revenue = current_month["revenue"]

            if previous_revenue != 0:

                growth_percent = (
                    (current_revenue - previous_revenue)
                    / previous_revenue
                ) * 100

                monthly_growth.append({
                    "from_year": previous_month["year"],
                    "from_month": previous_month["month"],
                    "to_year": current_month["year"],
                    "to_month": current_month["month"],
                    "growth_percent": round(growth_percent, 2)
                })

        largest_monthly_growth = max(
            monthly_growth,
            key=lambda x: x["growth_percent"]
        )

        largest_monthly_decline = min(
            monthly_growth,
            key=lambda x: x["growth_percent"]
        )

        
        # 4. DISCOUNT PATTERNS
        top_discount_group = max(
            discounts,
            key=lambda x: x["revenue"]
        )

        lowest_discount_group = min(
            discounts,
            key=lambda x: x["revenue"]
        )

        highest_units_discount_group = max(
            discounts,
            key=lambda x: x["units_sold"]
        )

        
        # 5. CATEGORY REVENUE CONCENTRATION
        total_category_revenue = sum(
            category["revenue"]
            for category in categories
        )

        top_category_revenue_share = (
            top_category["revenue"]
            / total_category_revenue
        ) * 100

        
        # 6. FINAL BUSINESS PATTERNS
        patterns = {

            "category_patterns": {
                "top_revenue_category": top_category,
                "lowest_revenue_category": lowest_category,
                "highest_rated_category": highest_rated_category,
                "lowest_rated_category": lowest_rated_category,
                "top_category_revenue_share_percent":
                    round(top_category_revenue_share, 2)
            },

            "regional_patterns": {
                "top_revenue_region": top_region,
                "lowest_revenue_region": lowest_region,
                "highest_rated_region": highest_rated_region,
                "lowest_rated_region": lowest_rated_region
            },

            "monthly_patterns": {
                "best_revenue_month": best_month,
                "worst_revenue_month": worst_month,
                "largest_monthly_growth": largest_monthly_growth,
                "largest_monthly_decline": largest_monthly_decline
            },

            "discount_patterns": {
                "top_revenue_discount_group": top_discount_group,
                "lowest_revenue_discount_group": lowest_discount_group,
                "highest_units_discount_group":
                    highest_units_discount_group
            }
        }

        print("Detected Business Patterns:")
        print(patterns)

        return patterns

