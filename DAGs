    @task
    def validate_ai_insights(ai_insights: dict):

        required_fields = {
            "executive_summary": str,
            "key_findings": list,
            "trend_analysis": str,
            "category_insights": list,
            "regional_insights": list,
            "discount_insights": list,
            "customer_feedback_insights": list,
            "risks": list,
            "opportunities": list,
            "recommendations": list,
            "follow_up_questions": list
        }

       
        # 1. Validate response type
        
        if not isinstance(ai_insights, dict):
            raise ValueError(
                "AI insights must be returned as a dictionary."
            )

        
        # 2. Validate required fields
        
        for field, expected_type in required_fields.items():

            if field not in ai_insights:
                raise ValueError(
                    f"Missing required AI insight field: {field}"
                )

            if not isinstance(ai_insights[field], expected_type):
                raise ValueError(
                    f"Field '{field}' must be of type "
                    f"{expected_type.__name__}."
                )

        
        # 3. Validate important text fields
        
        if not ai_insights["executive_summary"].strip():
            raise ValueError(
                "Executive summary cannot be empty."
            )

        if not ai_insights["trend_analysis"].strip():
            raise ValueError(
                "Trend analysis cannot be empty."
            )

        
        # 4. Validate list fields
       
        list_fields = [
            "key_findings",
            "category_insights",
            "regional_insights",
            "discount_insights",
            "customer_feedback_insights",
            "risks",
            "opportunities",
            "recommendations",
            "follow_up_questions"
        ]

        for field in list_fields:

            if len(ai_insights[field]) == 0:
                raise ValueError(
                    f"Field '{field}' cannot be empty."
                )

            for item in ai_insights[field]:

                if not isinstance(item, str):
                    raise ValueError(
                        f"All items in '{field}' must be strings."
                    )

                if not item.strip():
                    raise ValueError(
                        f"Field '{field}' contains an empty string."
                    )

        print("AI insights validation successful.")

        return ai_insights

    def format_list_for_bi(value):
    

        if value is None:
            return None

        if not isinstance(value, list):
            return value

        return "\n".join(
            f"• {str(item).strip()}"
            for item in value
            if item is not None and str(item).strip()
        )

    
    def format_ai_insights_for_bi(insights):
   

        list_fields = [
        "key_findings",
        "category_insights",
        "regional_insights",
        "discount_insights",
        "customer_feedback_insights",
        "anomaly_explanations",
        "risks",
        "opportunities",
        "recommendations",
        "follow_up_questions"
        ]

        formatted = insights.copy()

        for field in list_fields:
            if field in formatted:
                formatted[field] = format_list_for_bi(
                    formatted[field]
                )

        return formatted

